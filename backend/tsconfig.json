/**
 * @file tsconfig.json
 * @description This file contains the TypeScript configuration for the backend of the application. It specifies
 * the compiler options, including target ECMAScript version, module system, library definitions, and other
 * settings that control how TypeScript code is compiled to JavaScript. The configuration also defines which
 * files to include and exclude during the compilation process, ensuring that the TypeScript code is properly
 * transpiled and organized in the output directory.
 */

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
