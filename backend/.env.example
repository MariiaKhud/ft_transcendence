# Database
DATABASE_URL=postgresql://user:password@postgres:5432/transcendence

# Server
PORT=3000
NODE_ENV=development

# Frontend
FRONTEND_URL=https://localhost

# JWT
JWT_SECRET=replace-with-a-strong-random-secret

# OAuth 2.0
# Supported values for OAUTH_PROVIDER: github, google, 42
OAUTH_PROVIDER=github
OAUTH_CLIENT_ID=replace-with-oauth-client-id
OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
OAUTH_CALLBACK_URL=https://localhost:8443/api/auth/oauth/github/callback
OAUTH_SUCCESS_REDIRECT=https://localhost:8443/
OAUTH_ERROR_REDIRECT=https://localhost:8443/login

# Email (optional, for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
