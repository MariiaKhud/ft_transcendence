# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/transcendence

# JWT Secret (change this!)
JWT_SECRET=your-super-secret-jwt-key-change-me

# Environment (development, production, test)
NODE_ENV=development

# Backend port
BACKEND_PORT=3000

# Frontend port
FRONTEND_PORT=5173

# Upload path
UPLOAD_PATH=./uploads
