# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/transcendence

# JWT Secret (change this!)
JWT_SECRET=your-super-secret-jwt-key-change-me

# Environment (development, production, test)
NODE_ENV=development

# Backend port
BACKEND_PORT=3000

# Frontend port
FRONTEND_PORT=5173

# Upload path
UPLOAD_PATH=./uploads

# OAuth 2.0
# Supported values for OAUTH_PROVIDER: github, google, 42
OAUTH_PROVIDER=github
OAUTH_CLIENT_ID=replace-with-oauth-client-id
OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
OAUTH_CALLBACK_URL=https://localhost:8443/api/auth/oauth/github/callback
OAUTH_SUCCESS_REDIRECT=https://localhost:8443/
OAUTH_ERROR_REDIRECT=https://localhost:8443/login
